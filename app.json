{
  "expo": {
    "name": "Lowlight",
    "slug": "lowlight",
    "version": "1.0.0",
    "scheme": "lowlight",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F4F6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lowlight.app"
    },
    "android": {
      "package": "com.lowlight.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "foregroundImage": "./assets/adaptive-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "_comment_blockedPermissions": "Lowlight: only POST_NOTIFICATIONS (opt-in evening wind-down and morning log reminders, inexact triggers; RECEIVE_BOOT_COMPLETED keeps them after a reboot) and VIBRATE. INTERNET and SYSTEM_ALERT_WINDOW blocked. No usage-stats access: screen time is logged by hand.",
      "blockedPermissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_SMS",
        "android.permission.READ_CALL_LOG",
        "android.permission.QUERY_ALL_PACKAGES",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5D2852"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
